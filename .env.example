# Copy to .env and adjust. Never commit real secrets.
# --- server ---
PORT=8000
HOST=127.0.0.1
CORS_ORIGIN=true
LOG_LEVEL=info
# --- infra (local defaults match `bun run infra:up`) ---
POSTGRES_USER=spatial
POSTGRES_PASSWORD=spatial-dev
POSTGRES_DB=spatial
DATABASE_URL=postgres://spatial:spatial-dev@127.0.0.1:5432/spatial
REDIS_URL=redis://127.0.0.1:6379
# --- frontend (Vite; empty VITE_API_BASE_URL = same-origin via dev proxy) ---
API_BASE_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000/ws/avatars
# --- compose port bindings ---
SERVER_PORT=8000
WEB_PORT=8080
