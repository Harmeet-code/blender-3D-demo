# ---- build (Vite emits base '/floorplan/' asset URLs, see vite.config.ts)
FROM oven/bun:1 AS build
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install
COPY . .
RUN bun run build

# ---- serve (nginx hosts the static bundle under /floorplan/)
FROM nginx:1-alpine
COPY --from=build /app/dist /usr/share/nginx/html/floorplan
COPY docker/nginx.floorplan.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
