{
  "name": "blender-3d-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive 3D spatial web app: floor-plan admin builder, multi-floor navigation, avatar interaction, e-commerce add-ons, realtime multiplayer.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "bun --watch src/server/index.ts",
    "dev:all": "bun run --concurrent dev dev:server",
    "build": "tsc -b && vite build",
    "build:server": "bun build ./src/server/index.ts --outdir dist-server --target bun",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "db:migrate": "bun src/server/db/migrate.ts",
    "db:seed": "bun src/server/db/seed.ts",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "prepare": "husky"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/websocket": "^11.0.1",
    "@react-three/drei": "^10.3.0",
    "@react-three/fiber": "^9.1.2",
    "@react-three/rapier": "^2.1.0",
    "@types/three": "^0.180.0",
    "fastify": "^5.4.0",
    "gsap": "^3.13.0",
    "ioredis": "^6.0.0",
    "konva": "^10.7.0",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-konva": "^19.0.3",
    "socket.io-client": "^4.8.1",
    "three": "^0.180.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@tailwindcss/vite": "^4.1.12",
    "@types/bun": "^1.2.21",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
