{
  "name": "blender-3d-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive 3D spatial web app: floor-plan admin builder, multi-floor navigation, avatar interaction, e-commerce add-ons, realtime multiplayer.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:frontend": "vite",
    "dev:server": "bun --watch src/server/index.ts",
    "dev:all": "concurrently -n web,server -c blue,green \"bun run dev:frontend\" \"bun run dev:server\"",
    "build": "tsc -b && vite build",
    "build:server": "bun build ./src/server/index.ts --outdir dist-server --target bun",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "verify": "bun run typecheck && bun run lint && bun run format:check && bun test",
    "test": "bun test",
    "assets:validate": "bun scripts/assets/validate.ts",
    "assets:calibration": "bun scripts/assets/calibration-and-optimization.ts",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "clean": "rm -rf dist dist-server coverage",
    "slice:new": "bun scripts/new-slice.ts",
    "db:migrate": "bun src/server/db/migrate.ts",
    "db:seed": "bun src/server/db/seed.ts",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "prepare": "husky"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/websocket": "^11.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@react-three/drei": "^10.3.0",
    "@react-three/fiber": "^9.1.2",
    "@react-three/rapier": "^2.1.0",
    "@types/three": "^0.180.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "fastify": "^5.4.0",
    "fastify-plugin": "^6.0.0",
    "gsap": "^3.13.0",
    "ioredis": "^6.0.0",
    "konva": "^10.7.0",
    "lucide-react": "^1.49.0",
    "neverthrow": "^8.2.0",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-konva": "^19.0.3",
    "shadcn": "^4.21.0",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.8",
    "three": "^0.180.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@gltf-transform/core": "4.5.1",
    "@tailwindcss/vite": "^4.1.12",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.2.21",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.5",
    "gltf-validator": "2.0.0-dev.3.10",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
